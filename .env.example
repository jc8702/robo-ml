# ===================================
# ML Ofertas Bot - Configuração
# ===================================

# --- Mercado Livre Afiliados ---
ML_AFFILIATE_ID=seu-tracking-id-aqui
ML_AFFILIATE_SOURCE=whatsapp

# --- API Oficial (opcional) ---
ML_ACCESS_TOKEN=

# --- Instagram API oficial (private replies por comentário) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v23.0

# --- Automação & WhatsApp ---
# ID do grupo de WhatsApp para envio automático (ex: 120363000000000000@g.us)
# Obtenha os IDs executando: npm run list-groups
WHATSAPP_GROUP_ID=

# Frequência de execução automática em formato Cron
# '0 */3 * * *' = A cada 3 horas
# '0 */2 * * *' = A cada 2 horas
# '0 9,13,18 * * *' = Às 09:00, 13:00 e 18:00
AUTO_SCHEDULE_CRON=0 */3 * * *

# --- Filtros de Ofertas ---
ML_MIN_DISCOUNT=0
ML_MIN_PRICE=30
ML_MAX_PRICE=500
ML_MAX_RESULTS=10

# --- Categorias & Queries ---
ML_CATEGORIES=
ML_DEFAULT_QUERIES=ofertas do dia,mais vendidos,promoção

# --- Output ---
ML_OUTPUT_FORMAT=individual
ML_AUTO_CLIPBOARD=true
